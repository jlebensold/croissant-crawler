# Copy to .env (docker compose and the CLI both read it). Everything is optional except where noted.

# --- LLM enrichment (optional; without it the crawl/index/graph still work) -------------------
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_FALLBACK_MODELS=["google/gemini-2.5-flash-lite"]
LLM_CONCURRENCY=12
LLM_RATE_PER_SECOND=6

# --- crawling -----------------------------------------------------------------------------------
# Identify your deployment to upstream platforms.
USER_AGENT=croissant-crawler/0.1 (+https://github.com/jlebensold/croissant-crawler)
SOURCES_ENABLED=["huggingface","openml","kaggle","dataverse","web"]
# requests/second per source (enforced per Temporal task queue AND per process)
SOURCE_RATES={"huggingface": 1.5, "openml": 3, "kaggle": 1, "dataverse": 2, "web": 2}
DATAVERSE_INSTANCES=["https://dataverse.harvard.edu"]
# Seeds for the generic web source: comma-separated Croissant URLs, HTML pages or sitemap .xml files
WEB_SEEDS=
RECRAWL_MIN_HOURS=24
RECRAWL_MAX_DAYS=30
# Optional credentials raise upstream rate limits
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- search -------------------------------------------------------------------------------------
TYPESENSE_API_KEY=croissant-dev-key
# Built-in model runs inside the Typesense container (downloaded on first use). "" disables semantic search.
TYPESENSE_EMBEDDING_MODEL=ts/all-MiniLM-L12-v2

# --- web ----------------------------------------------------------------------------------------
WEB_TITLE=Croissant Index
# Set to false on public deployments: hides the "Run pipeline" button / admin API.
ENABLE_ADMIN_ACTIONS=true

# --- host ports (docker compose) ----------------------------------------------------------------
# WEB_HOST_PORT=8000
# POSTGRES_HOST_PORT=5432
# TYPESENSE_HOST_PORT=8108
# TEMPORAL_HOST_PORT=7233
# TEMPORAL_UI_HOST_PORT=8233

# --- only needed when running the Python processes outside docker -------------------------------
# DATABASE_URL=postgresql://crawler:crawler@localhost:5432/crawler
# TYPESENSE_URL=http://localhost:8108
# TEMPORAL_ADDRESS=localhost:7233
